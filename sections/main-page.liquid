{%- comment -%} Generic page (e.g. Info). {%- endcomment -%}
<div class="whane-page">
  <h1 class="whane-display" style="font-size:72px; line-height:0.86; letter-spacing:-2px; margin-bottom:32px;">{{ page.title | escape }}</h1>
  <div class="whane-rte">{{ page.content }}</div>
</div>

{% schema %}
{
  "name": "Page",
  "tag": "section",
  "settings": []
}
{% endschema %}
