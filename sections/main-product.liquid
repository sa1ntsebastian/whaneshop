{%- comment -%} Product page — sparse, editorial, two-color. {%- endcomment -%}
{%- liquid
  assign limited_to = product.metafields.custom.limited_to.value
  assign closes_at = product.metafields.custom.drop_closes_at.value
-%}

<article class="whane-product">
  <div class="whane-product__media {% unless product.featured_image %}whane-placeholder--on-cobalt{% endunless %}" {% if product.images.size > 0 %}data-carousel{% endif %}>
    {%- if product.images.size > 0 -%}
      {%- if product.images.size > 1 -%}
        <button type="button" class="pgal__arrow pgal__arrow--prev" data-carousel-prev aria-label="Previous image">&larr;</button>
        <button type="button" class="pgal__arrow pgal__arrow--next" data-carousel-next aria-label="Next image">&rarr;</button>
        <span class="pgal__counter" data-carousel-counter aria-hidden="true">01 / {{ product.images.size }}</span>
      {%- endif -%}
      <div class="pgal__track" data-carousel-track tabindex="0" aria-label="{{ product.title | escape }} images">
        {%- for image in product.images -%}
          {%- liquid
            assign loading = 'lazy'
            if forloop.first
              assign loading = 'eager'
            endif
          -%}
          <div class="pgal__slide" data-carousel-slide>
            {{ image | image_url: width: 1400 | image_tag: alt: image.alt | default: product.title, loading: loading, sizes: '50vw', widths: '600,900,1400,1800' }}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <div class="whane-product__info">
    {%- comment -%}
      Split a title like "WHANE. Tee — W.1.1": the code (after the dash) shows
      small ABOVE the name. Handles em dash, en dash and a normal hyphen
      (with surrounding spaces, so codes like "W.1.1" aren't broken up).
    {%- endcomment -%}
    {%- liquid
      assign sep = ''
      if product.title contains '—'
        assign sep = '—'
      elsif product.title contains '–'
        assign sep = '–'
      elsif product.title contains ' - '
        assign sep = ' - '
      endif
      assign main_title = product.title
      assign code = ''
      if sep != blank
        assign title_parts = product.title | split: sep
        assign main_title = title_parts[0] | strip
        assign code = title_parts | last | strip
      endif
    -%}
    {%- if code != blank -%}
      <span class="whane-product__code whane-meta">{{ code }}</span>
    {%- elsif product.metafields.custom.drop_number != blank -%}
      <span class="whane-product__code whane-meta">Drop {{ product.metafields.custom.drop_number.value }}</span>
    {%- endif -%}

    <h1 class="whane-product__title">{{ main_title | escape }}</h1>
    <div class="whane-product__price whane-meta">{{ product.price | money }}</div>

    {%- if limited_to != blank -%}
      <div class="whane-meta" style="font-size:12px; margin-top:18px;">Limited to {{ limited_to }}</div>
    {%- endif -%}

    {%- form 'product', product, class: 'whane-product__form' -%}
      {%- unless product.has_only_default_variant -%}
        <div class="whane-product__variants" role="radiogroup" aria-label="{{ product.options_with_values.first.name }}">
          {%- for variant in product.variants -%}
            <label class="whane-variant {% if variant == product.selected_or_first_available_variant %}whane-variant--active{% endif %} {% unless variant.available %}whane-card__soldout{% endunless %}">
              <input type="radio" name="id" value="{{ variant.id }}" class="visually-hidden"
                {% if variant == product.selected_or_first_available_variant %}checked{% endif %}
                {% unless variant.available %}disabled{% endunless %}>
              {{ variant.title | escape }}
            </label>
          {%- endfor -%}
        </div>
      {%- else -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      {%- endunless -%}

      {%- if product.available -%}
        <button type="submit" name="add" class="whane-btn">Buy now</button>
      {%- else -%}
        <button type="button" class="whane-btn" aria-disabled="true" disabled>Sold out</button>
      {%- endif -%}
    {%- endform -%}

    {%- if product.description != blank -%}
      <div class="whane-product__desc whane-rte">{{ product.description }}</div>
    {%- endif -%}
  </div>
</article>

<script src="{{ 'carousel.js' | asset_url }}" defer="defer"></script>
<script>
  // Keep the variant radio buttons visually in sync (flat active state).
  document.querySelectorAll('.whane-product__variants').forEach(function (group) {
    group.addEventListener('change', function (e) {
      group.querySelectorAll('.whane-variant').forEach(function (l) { l.classList.remove('whane-variant--active'); });
      var label = e.target.closest('.whane-variant');
      if (label) { label.classList.add('whane-variant--active'); }
    });
  });
</script>

{% schema %}
{
  "name": "Product",
  "tag": "section",
  "settings": []
}
{% endschema %}
