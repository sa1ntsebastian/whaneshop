{%- comment -%} Cart — flat, monospace, two-color. {%- endcomment -%}
<div class="whane-cart">
  <h1 class="whane-cart__title">Cart</h1>

  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" novalidate>
      {%- for item in cart.items -%}
        <div class="whane-cart__row">
          <a class="whane-link" href="{{ item.url }}" style="border:0;">{{ item.product.title | escape }}{% unless item.product.has_only_default_variant %} — {{ item.variant.title | escape }}{% endunless %}</a>
          <div>
            <input type="number" name="updates[]" value="{{ item.quantity }}" min="0"
                   aria-label="Quantity"
                   style="width:64px; border:1px solid {{ settings.color_cobalt }}; background:{{ settings.color_white }}; color:{{ settings.color_cobalt }}; font-family:'Courier New',monospace; padding:8px; text-align:center;">
          </div>
          <div style="text-align:right;">{{ item.final_line_price | money }}</div>
        </div>
      {%- endfor -%}

      <div class="whane-cart__foot">
        <button type="submit" name="update" class="whane-link" style="font-size:12px;">Update</button>
        <span class="whane-meta" style="font-size:13px;">Subtotal — {{ cart.total_price | money }}</span>
      </div>

      <div style="margin-top:32px; max-width:320px;">
        <button type="submit" name="checkout" class="whane-btn">Checkout</button>
      </div>
    </form>
  {%- else -%}
    <p class="whane-meta" style="font-size:13px;">Your cart is empty.</p>
    <p style="margin-top:24px;"><a class="whane-link" href="{{ routes.all_products_collection_url }}" style="font-size:12px;">Enter shop →</a></p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Cart",
  "tag": "section",
  "settings": []
}
{% endschema %}
