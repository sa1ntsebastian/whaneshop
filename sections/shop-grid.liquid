{%- comment -%}
  Shop / Drops — overview grid. Replaces the one-product-at-a-time carousel so
  every piece in the drop is visible at a glance (no product is buried behind
  swipes). Each card links to its product page. Scarcity is shown per card as a
  live availability count + bar. Sold-out stays visible (struck through).
{%- endcomment -%}

{%- liquid
  assign collection = collections[section.settings.collection]
  assign products = collection.products
-%}

<section class="shop-grid">
  {% render 'menu-band' %}

  <div class="shop-grid__body">
    <div class="shop-grid__head">
      <h1 class="shop-grid__title">{{ section.settings.heading | default: 'Shop' | escape }}</h1>
      {%- if products.size > 0 -%}
        <span class="whane-meta" style="font-size:12px;">{{ products.size }} {% if products.size == 1 %}object{% else %}objects{% endif %}</span>
      {%- endif -%}
    </div>

    {%- if products.size > 0 -%}
      <div class="whane-grid shop-grid__grid">
        {%- for product in products -%}
          {%- liquid
            assign item_code = product.metafields.custom.item_code.value
            assign drop_number = product.metafields.custom.drop_number.value

            assign limited_to = 0
            if product.metafields.custom.limited_to != blank
              assign limited_to = product.metafields.custom.limited_to.value | plus: 0
            endif

            comment
              Shared inventory pool (Connected Inventory): every size mirrors the
              same pool, so "available" is the quantity of a SINGLE variant (use
              the max across tracked variants), NOT the sum.
            endcomment
            assign available = 0
            assign has_tracked = false
            for variant in product.variants
              if variant.inventory_management != blank
                assign has_tracked = true
                if variant.inventory_quantity > available
                  assign available = variant.inventory_quantity
                endif
              endif
            endfor
            unless has_tracked
              assign available = section.settings.fallback_available | plus: 0
            endunless
            if available < 0
              assign available = 0
            endif

            assign sold = limited_to | minus: available
            assign fill_pct = 0
            if limited_to > 0
              assign fill_pct = sold | times: 100 | divided_by: limited_to
              if fill_pct < 0
                assign fill_pct = 0
              endif
              if fill_pct > 100
                assign fill_pct = 100
              endif
            endif
          -%}
          <div class="whane-card">
            <div class="whane-card__media {% unless product.featured_image %}whane-placeholder--on-white{% endunless %}" {% if product.images.size > 1 %}data-carousel{% endif %}>
              {%- if product.images.size > 0 -%}
                {%- if product.images.size > 1 -%}
                  <button type="button" class="cardgal__arrow cardgal__arrow--prev" data-carousel-prev aria-label="Previous image">&larr;</button>
                  <button type="button" class="cardgal__arrow cardgal__arrow--next" data-carousel-next aria-label="Next image">&rarr;</button>
                  <span class="cardgal__counter" data-carousel-counter aria-hidden="true">01 / {{ product.images.size }}</span>
                {%- endif -%}
                <div class="cardgal__track" data-carousel-track tabindex="0" aria-label="{{ product.title | escape }} images">
                  {%- for image in product.images -%}
                    <a class="cardgal__slide" data-carousel-slide href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                      {{ image | image_url: width: 700 | image_tag: alt: image.alt | default: product.title, loading: 'lazy', sizes: '(max-width:599px) 100vw, (max-width:999px) 50vw, 33vw', widths: '350,500,700,1000' }}
                    </a>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>

            <a class="whane-card__link" href="{{ product.url }}">
              {%- if item_code != blank -%}
                <span class="whane-card__code whane-meta">{{ item_code }}</span>
              {%- elsif drop_number != blank -%}
                <span class="whane-card__code whane-meta">Drop {{ drop_number }}</span>
              {%- endif -%}

              <span class="whane-card__title {% unless product.available and available > 0 %}whane-card__soldout{% endunless %}">{{ product.title | escape }}</span>
              <span class="whane-card__price">
                {%- if product.available and available > 0 -%}{{ product.price | money }}{%- else -%}{{ section.settings.sold_out_label | escape }}{%- endif -%}
              </span>
            </a>

            {%- if limited_to > 0 -%}
              <span class="whane-card__avail">
                <span class="whane-card__count">{{ available }} / {{ limited_to }}</span>
                <span class="whane-card__bar" role="progressbar" aria-valuenow="{{ fill_pct }}" aria-valuemin="0" aria-valuemax="100" aria-label="Claimed">
                  <span class="whane-card__bar-fill" style="width: {{ fill_pct }}%;"></span>
                </span>
              </span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

    {%- elsif section.settings.show_placeholders -%}
      {%- comment -%} Demo grid so the layout is testable before a collection is connected. {%- endcomment -%}
      {%- liquid
        assign ph_titles = section.settings.ph_titles | split: ','
        assign ph_prices = section.settings.ph_prices | split: ','
        assign ph_avail  = section.settings.ph_available | split: ','
        assign ph_limit  = section.settings.ph_limited | split: ','
      -%}
      <div class="whane-grid shop-grid__grid">
        {%- for title in ph_titles -%}
          {%- liquid
            assign i = forloop.index0
            assign avail = ph_avail[i] | plus: 0
            assign limit = ph_limit[i] | plus: 0
            assign fill_pct = 0
            if limit > 0
              assign sold = limit | minus: avail
              assign fill_pct = sold | times: 100 | divided_by: limit
            endif
          -%}
          <span class="whane-card">
            <span class="whane-card__media whane-placeholder--on-white"></span>
            <span class="whane-card__code whane-meta">Drop 01 · demo</span>
            <span class="whane-card__title {% if avail <= 0 %}whane-card__soldout{% endif %}">{{ title | strip }}</span>
            <span class="whane-card__price">
              {%- if avail > 0 -%}{{ ph_prices[i] | strip }}{%- else -%}{{ section.settings.sold_out_label | escape }}{%- endif -%}
            </span>
            <span class="whane-card__avail">
              <span class="whane-card__count">{{ avail }} / {{ limit }}</span>
              <span class="whane-card__bar" role="progressbar" aria-valuenow="{{ fill_pct }}" aria-valuemin="0" aria-valuemax="100" aria-label="Claimed">
                <span class="whane-card__bar-fill" style="width: {{ fill_pct }}%;"></span>
              </span>
            </span>
          </span>
        {%- endfor -%}
      </div>

    {%- else -%}
      <p class="whane-meta" style="font-size:13px;">
        {%- if section.settings.collection == blank -%}
          Select a collection in the theme editor.
        {%- else -%}
          No products in this drop yet.
        {%- endif -%}
      </p>
    {%- endif -%}
  </div>
</section>

<script src="{{ 'carousel.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Shop / Grid",
  "tag": "section",
  "class": "section-shop-grid",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Drop collection", "info": "Products shown in the grid." },
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (when no item code / drop number)", "default": "The current drop" },
    { "type": "text", "id": "sold_out_label", "label": "Sold-out label", "default": "Sold out" },
    { "type": "header", "content": "Scarcity" },
    { "type": "text", "id": "fallback_available", "label": "Available (fallback)", "default": "20", "info": "Used only when a product has no tracked inventory." },
    { "type": "header", "content": "Placeholder demo" },
    { "type": "checkbox", "id": "show_placeholders", "label": "Show demo products when no collection / empty", "default": true, "info": "Lets you test the grid before connecting a collection. Turn off for production." },
    { "type": "text", "id": "ph_titles", "label": "Demo titles (comma-separated)", "default": "Field Jacket,Field Cap,Mono Tee" },
    { "type": "text", "id": "ph_prices", "label": "Demo prices (comma-separated)", "default": "€280,€90,€60" },
    { "type": "text", "id": "ph_available", "label": "Demo available (comma-separated)", "default": "37,0,120" },
    { "type": "text", "id": "ph_limited", "label": "Demo limited-to (comma-separated)", "default": "100,50,200" }
  ],
  "presets": [{ "name": "Shop / Grid" }]
}
{% endschema %}
