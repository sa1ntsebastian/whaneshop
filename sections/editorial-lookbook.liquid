{%- comment -%}
  Lookbook — "Editorial". Full-bleed on-figure image, sparse white overlay.
  Full screen, no scroll. Menu band overlaid in white (every page but home).
{%- endcomment -%}

<section class="lookbook">
  <div class="lookbook__media {% unless section.settings.image %}whane-placeholder--on-cobalt{% endunless %}">
    {%- if section.settings.image -%}
      {{ section.settings.image | image_url: width: 2000 | image_tag: alt: section.settings.heading, loading: 'eager', sizes: '100vw', widths: '800,1200,1600,2000,2600' }}
    {%- else -%}
      <span class="lookbook__media-note">Full-body look · on-figure shot</span>
    {%- endif -%}
  </div>

  {% render 'menu-band', variant: 'overlay' %}

  <div class="lookbook__bottom">
    <div>
      <h1 class="lookbook__heading">{{ section.settings.heading | escape | newline_to_br }}</h1>
      {%- if section.settings.look_number != blank -%}
        <span class="lookbook__looknum whane-meta">{{ section.settings.look_number | escape }}</span>
      {%- endif -%}
    </div>
    {%- if section.settings.cta_label != blank -%}
      <a class="lookbook__enter whane-link whane-link--on-cobalt" href="{{ section.settings.cta_url | default: settings.nav_shop_link | default: routes.all_products_collection_url }}">
        {{ section.settings.cta_label | escape }} →
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Editorial lookbook",
  "tag": "section",
  "class": "section-lookbook",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Full-bleed image", "info": "Full-body on-figure shot." },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Autumn\nField", "info": "Line breaks become two lines." },
    { "type": "text", "id": "look_number", "label": "Look number", "default": "Look 01 / 06" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Enter shop" },
    { "type": "url", "id": "cta_url", "label": "CTA link", "info": "Defaults to the Shop nav link." }
  ],
  "presets": [{ "name": "Editorial lookbook" }]
}
{% endschema %}
