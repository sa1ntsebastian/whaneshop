{%- comment -%}
  Lookbook — "Editorial". Full-screen carousel of on-figure looks.
  Browse left/right (arrows) or swipe. Sparse white overlay; menu band on top.
  Each look is a block (image + heading + look number + optional CTA).
{%- endcomment -%}

<section class="lookbook" data-carousel>
  {% render 'menu-band', variant: 'overlay' %}

  <div class="lookbook__viewport">
    {%- if section.blocks.size > 1 -%}
      <button type="button" class="lookbook__arrow lookbook__arrow--prev" data-carousel-prev aria-label="Previous look">&larr;</button>
      <button type="button" class="lookbook__arrow lookbook__arrow--next" data-carousel-next aria-label="Next look">&rarr;</button>
      <span class="lookbook__counter" data-carousel-counter aria-hidden="true">01 / {{ section.blocks.size }}</span>
    {%- endif -%}

    <div class="lookbook__track" data-carousel-track tabindex="0" aria-label="Looks">
      {%- for block in section.blocks -%}
        {%- liquid
          assign loading = 'lazy'
          if forloop.first
            assign loading = 'eager'
          endif
        -%}
        <div class="lookbook__slide" data-carousel-slide {{ block.shopify_attributes }}>
          <div class="lookbook__media {% unless block.settings.image %}whane-placeholder--on-cobalt{% endunless %}">
            {%- if block.settings.image -%}
              {{ block.settings.image | image_url: width: 2000 | image_tag: alt: block.settings.heading, loading: loading, sizes: '100vw', widths: '800,1200,1600,2000,2600' }}
            {%- else -%}
              <span class="lookbook__media-note">Full-body look · on-figure shot</span>
            {%- endif -%}
          </div>

          <div class="lookbook__bottom">
            <div>
              <h2 class="lookbook__heading">{{ block.settings.heading | escape | newline_to_br }}</h2>
              {%- if block.settings.look_number != blank -%}
                <span class="lookbook__looknum whane-meta">{{ block.settings.look_number | escape }}</span>
              {%- endif -%}
            </div>
            {%- if block.settings.cta_label != blank -%}
              <a class="lookbook__enter whane-link whane-link--on-cobalt" href="{{ block.settings.cta_url | default: settings.nav_shop_link | default: routes.all_products_collection_url }}">
                {{ block.settings.cta_label | escape }} →
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- else -%}
        <div class="lookbook__slide" data-carousel-slide>
          <div class="lookbook__media whane-placeholder--on-cobalt">
            <span class="lookbook__media-note">Add looks in the theme editor</span>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<script src="{{ 'carousel.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Editorial lookbook",
  "tag": "section",
  "class": "section-lookbook",
  "max_blocks": 12,
  "blocks": [
    {
      "type": "look",
      "name": "Look",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Full-body on-figure shot." },
        { "type": "textarea", "id": "heading", "label": "Heading", "default": "Autumn\nField", "info": "Line breaks become two lines." },
        { "type": "text", "id": "look_number", "label": "Look number", "default": "Look 01 / 06" },
        { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Enter shop" },
        { "type": "url", "id": "cta_url", "label": "CTA link", "info": "Defaults to the Shop nav link." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial lookbook",
      "blocks": [
        { "type": "look", "settings": { "heading": "Autumn\nField", "look_number": "Look 01 / 06" } },
        { "type": "look", "settings": { "heading": "Cobalt\nHour", "look_number": "Look 02 / 06" } },
        { "type": "look", "settings": { "heading": "Field\nNotes", "look_number": "Look 03 / 06" } }
      ]
    }
  ]
}
{% endschema %}
