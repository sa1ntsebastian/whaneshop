{%- comment -%}
  Info — full screen, sparse, no scroll. Menu band + page content.
  Uses the assigned page's title/content; falls back to section settings.
{%- endcomment -%}

<section class="info">
  {% render 'menu-band' %}

  <div class="info__body">
    <div class="info__inner">
      <h1 class="info__title">{{ page.title | default: section.settings.heading | escape }}</h1>
      <div class="whane-rte">
        {%- if page.content != blank -%}
          {{ page.content }}
        {%- else -%}
          {{ section.settings.text }}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Info",
  "tag": "section",
  "class": "section-info",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (fallback)", "default": "Info" },
    { "type": "richtext", "id": "text", "label": "Text (fallback)", "default": "<p>WHANE. Berlin. Limited, numbered drops. Reduction to the essential.</p>" }
  ],
  "presets": [{ "name": "Info" }]
}
{% endschema %}
